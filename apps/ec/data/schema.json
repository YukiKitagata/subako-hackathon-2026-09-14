{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EC商品データ",
  "description": "日本円の価格・在庫と、補足情報のmetadataを持つ商品カタログ。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "description",
    "items"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "price",
        "stock"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "商品間で一意にする。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "price": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000,
          "description": "1点あたりのデモ価格（日本円）。"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "default": "点"
        },
        "stock": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "tags": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "default": []
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/json"
          },
          "default": {},
          "description": "商品カードには表示せず、検索に利用する補足情報。実行時には入れ子8段階まで。"
        }
      }
    }
  }
}
