{
  "name": "subako-hackathon-2026-09-14",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:todo": "npm run dev --workspace @hackathon/todo",
    "dev:todo-integrated": "npm run dev --workspace @hackathon/todo-integrated",
    "dev:map": "npm run dev --workspace @hackathon/map",
    "dev:map-coffee": "npm run dev --workspace @hackathon/map-coffee",
    "dev:ec": "npm run dev --workspace @hackathon/ec",
    "dev:ec-coffee": "npm run dev --workspace @hackathon/ec-coffee",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "setup": "node scripts/setup.mjs",
    "agent:publish": "node scripts/agent.mjs publish",
    "agent:origins": "node scripts/agent.mjs origins",
    "agent:models": "node scripts/agent.mjs models"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "tsx": "4.23.13"
  },
  "dependencies": {
    "@subako-ai/sdk": "0.1.2"
  }
}
