# このキーは開発サーバーだけが使います。ブラウザーへは渡りません。
SUBAKO_API_KEY=
# 接続先。秘密ではないので、ブラウザーにも渡します。
VITE_SUBAKO_BASE_URL=https://api.us.cloud.subako.ai

# agent:models の結果から運営が指定した値を入れます。
SUBAKO_MODEL_PROVIDER_ID=
SUBAKO_MODEL_ID=
SUBAKO_MODEL_FORMAT=
# CLIのconfig-exampleと同じ初期値。運営指定があれば変更します。
SUBAKO_MODEL_CONTEXT_WINDOW=128000

# 任意：外部プレビューのOrigin。パスや末尾の / は付けません。
SUBAKO_EXTRA_ORIGINS=

# 以下は agent:publish が更新します。
SUBAKO_AGENT_TODO=
SUBAKO_AGENT_TODO_INTEGRATED=
SUBAKO_AGENT_MAP=
SUBAKO_AGENT_MAP_COFFEE=
SUBAKO_AGENT_EC=
SUBAKO_AGENT_EC_COFFEE=
